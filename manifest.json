{
  "manifest_version": 3,
  "name": "じーのスキップ",
  "version": "666.667",
  "description": "顔ボタンやキーで動画を3秒間16倍速に。元の再生速度・音量へ戻します。",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["settings.js", "player-button.js", "content.js"],
      "css": ["player-button.css"]
    }
  ],
  "web_accessible_resources": [
    { "resources": ["assets/geno-faces.png"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "options_ui": { "page": "popup.html", "open_in_tab": true },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
